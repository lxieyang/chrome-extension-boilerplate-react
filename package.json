{
    "name": "chromium-extension-boilerplate",
    "version": "1.0.0",
    "description": "A Chromium extension boilerplate",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/Anonymous-Humanoid/chromium-extension-boilerplate.git"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "tsx ./webpack/build.ts",
        "start": "node --run=create-certs && tsx ./webpack/webserver.ts",
        "check": "npm-run-all -cs tsc eslint:check prettier:check",
        "prettier": "prettier --config ./prettier.config.mjs --ignore-path ./.prettierignore **/*.{yml,yaml,js,cjs,mjs,ts,cts,mts,jsx,tsx,md,html,css,json,jsonc,json5}",
        "prettier:check": "node --run=prettier -- -c",
        "prettier:fix": "node --run=prettier -- -w",
        "eslint:check": "eslint -c ./eslint.config.mjs .",
        "eslint:fix": "node --run=eslint:check -- --fix",
        "tsc": "tsc",
        "create-certs": "node --run=create-ca && node --run=create-cert",
        "create-ca": "mkcert create-ca --key ./secrets/ca/ca.key --cert ./secrets/ca/ca.crt --validity 1",
        "create-cert": "mkcert create-cert --ca-key ./secrets/ca/ca.key --ca-cert ./secrets/ca/ca.crt --key ./secrets/cert/cert.key --cert ./secrets/cert/cert.crt --validity 1 --domains [\"localhost\",\"127.0.0.1\",\"[::1]\"]"
    },
    "dependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.10",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@types/chrome": "^0.0.316",
        "@types/fs-extra": "^11.0.4",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/react-refresh": "^0.14.6",
        "@types/zip-webpack-plugin": "^3.0.6",
        "@typescript-eslint/utils": "^8.28.0",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.7.3",
        "eslint": "^9.23.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsonc": "^2.20.0",
        "eslint-plugin-jsx-a11y": "^6.7.1",
        "eslint-plugin-react": "^7.37.4",
        "file-loader": "^6.2.0",
        "fs-extra": "^11.1.0",
        "globals": "^16.0.0",
        "html-loader": "^4.2.0",
        "html-webpack-plugin": "^5.5.0",
        "mkcert": "^3.2.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.5.3",
        "react-refresh": "^0.14.0",
        "react-refresh-typescript": "^2.0.10",
        "sass": "^1.57.1",
        "sass-loader": "^13.2.0",
        "source-map-loader": "^3.0.1",
        "style-loader": "^3.3.1",
        "terser-webpack-plugin": "^5.3.14",
        "ts-loader": "^9.5.4",
        "tsx": "^4.20.6",
        "type-fest": "^3.5.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.1",
        "webpack": "^5.75.0",
        "webpack-cli": "^4.10.0",
        "webpack-dev-server": "^5.2.2",
        "zip-webpack-plugin": "^4.0.1"
    }
}
